# ============================================
# Snort IDS - Reglas Agencia de Viajes
# ============================================

# --- Fuerza bruta en login ---
alert tcp any any -> any 8000 (msg:"[AGENCIA] BRUTE FORCE Login API"; threshold:type threshold, track by_src, count 10, seconds 60; sid:9000001; rev:1;)

# --- Escaneo puerto MySQL Master ---
alert tcp any any -> any 3306 (msg:"[AGENCIA] SCAN Puerto MySQL Master"; flags:S; threshold:type threshold, track by_src, count 5, seconds 30; sid:9000002; rev:1;)

# --- Escaneo puerto MySQL Slave ---
alert tcp any any -> any 3307 (msg:"[AGENCIA] SCAN Puerto MySQL Slave"; flags:S; threshold:type threshold, track by_src, count 5, seconds 30; sid:9000003; rev:1;)

# --- SQL Injection UNION SELECT ---
alert tcp any any -> any 8000 (msg:"[AGENCIA] SQL INJECTION UNION SELECT"; content:"UNION"; nocase; content:"SELECT"; nocase; sid:9000004; rev:1;)

# --- SQL Injection DROP TABLE ---
alert tcp any any -> any 8000 (msg:"[AGENCIA] SQL INJECTION DROP TABLE"; content:"DROP"; nocase; content:"TABLE"; nocase; sid:9000005; rev:1;)

# --- XSS Script tag ---
alert tcp any any -> any 8000 (msg:"[AGENCIA] XSS SCRIPT TAG"; content:"<script>"; nocase; sid:9000006; rev:1;)

# --- Flood DoS ---
alert tcp any any -> any 8000 (msg:"[AGENCIA] POSIBLE DoS FLOOD"; flags:S; threshold:type threshold, track by_src, count 50, seconds 10; sid:9000007; rev:1;)

# --- Acceso directo a MySQL desde fuera ---
alert tcp !172.20.0.0/16 any -> any 3306 (msg:"[AGENCIA] ACCESO NO AUTORIZADO MySQL"; sid:9000008; rev:1;)
